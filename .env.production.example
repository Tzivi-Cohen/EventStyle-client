# סביבת Production – ב-Render מגדירים את המשתנים במסך Environment של ה-Static Site (ראו render.yaml).
# אחרי כל שינוי יש ליצור Build חדש – הערכים נכנסים לקוד בזמן הבנייה. אין כאן סודות: הכול גלוי לדפדפן.
VITE_API_URL=https://<eventstyle-api>.onrender.com/api
# אותו Client ID כמו GOOGLE_CLIENT_ID בשרת. ב-Google Cloud Console יש להוסיף את כתובת האתר ל-Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=
# ריק = פרטי הסטודיו הציבוריים
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
