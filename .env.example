# העתיקי לקובץ .env.development ומלאי ערכים. הקובץ האמיתי לא עולה ל-Git.
# ב-Client אין סודות – רק הגדרות שגלויות לדפדפן.

# כתובת ה-API של השרת (כולל /api)
VITE_API_URL=http://localhost:4000/api

# Client ID של Google (אותו ערך כמו GOOGLE_CLIENT_ID בשרת, מסתיים ב-.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
