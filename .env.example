# סביבת Development – העתיקי לקובץ .env.development ומלאי ערכים. הקובץ האמיתי לא עולה ל-Git.
# ב-Client אין סודות – כל ערך כאן גלוי לדפדפן. לעולם לא לשים כאן סיסמאות, JWT_SECRET או מפתחות פרטיים.

# כתובת ה-API של השרת (כולל /api). חובה – בלעדיה האפליקציה לא עולה
VITE_API_URL=http://localhost:4000/api

# Client ID של Google (אותו ערך כמו GOOGLE_CLIENT_ID בשרת, מסתיים ב-.apps.googleusercontent.com). ריק = בלי כפתור Google
VITE_GOOGLE_CLIENT_ID=

# פרטי יצירת קשר להזמנות (רשות). ריק = פרטי הסטודיו הציבוריים (DEFAULT_CONTACT ב-src/config/env.ts)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
